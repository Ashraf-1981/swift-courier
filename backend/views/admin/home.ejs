<!doctype html>
<html>

<head>
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body class="p-4">
    <h1>Swift-Courier Admin</h1>
    <% if (admin) { %>
        <p>Hi <%= admin.name %> · <a href="/admin/logout">Log out</a></p>
        <ul class="list-unstyled mt-3">
            <li class="mb-2"><a href="/admin/orders" class="btn btn-outline-primary">Orders</a></li>
            <li class="mb-2"><a href="/admin/warehouse" class="btn btn-outline-primary">Warehouse</a></li>
        </ul>
        <% } else { %>
            <p>Not logged in · <a href="/admin/login">Log in</a></p>
            <% } %>
</body>

</html>