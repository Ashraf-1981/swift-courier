<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .table th,
        .table td {
            padding: 14px 18px;
            white-space: nowrap;
        }

        .table .row-paid>* {
            --bs-table-bg: #eef0f2;
        }
    </style>
</head>

<body class="p-4">
    <h1 class="h3">Orders</h1>
    <p><a href="/admin">← Admin home</a></p>
    <% if (msg) { %>
        <div class="alert alert-success">
            <%= msg %>
        </div>
        <% } %>
            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>
                    <form method="GET" action="/admin/orders" class="d-flex gap-2 mb-2">
                        <input type="text" name="ask" class="form-control" maxlength="200"
                            placeholder='Ask AI, e.g. "unpaid orders to Orchard last week"' value="<%= ask %>">
                        <button class="btn btn-dark">AI search</button>
                    </form>
                    <form method="GET" action="/admin/orders" class="row g-2 mb-3">
                        <div class="col-md-2">
                            <select name="status" class="form-select">
                                <option value="">All statuses</option>
                                <% statuses.forEach((s)=> { %>
                                    <option value="<%= s %>" <%=filters.status===s ? 'selected' : '' %>><%= s %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="payment" class="form-select">
                                <option value="">All payments</option>
                                <option value="unpaid" <%=filters.payment==='unpaid' ? 'selected' : '' %>>unpaid
                                </option>
                                <option value="paid" <%=filters.payment==='paid' ? 'selected' : '' %>>paid</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="zoneId" class="form-select">
                                <option value="">All zones</option>
                                <% zones.forEach((z)=> { %>
                                    <option value="<%= z.id %>" <%=filters.zoneId===z.id ? 'selected' : '' %>><%= z.name
                                            %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group">
                                <span class="input-group-text">From</span>
                                <input type="date" name="from" class="form-control" value="<%= filters.from || '' %>">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group">
                                <span class="input-group-text">To</span>
                                <input type="date" name="to" class="form-control" value="<%= filters.to || '' %>">
                            </div>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button class="btn btn-primary">Filter</button>
                            <a href="/admin/orders" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </form>

                    <p>
                        <%= orders.length %> order(s)
                    </p>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <tr class="table-secondary">
                                <th>Tracking no</th>
                                <th>Customer</th>
                                <th>Pickup</th>
                                <th>Drop-off</th>
                                <th>Status</th>
                                <th>Method</th>
                                <th>Payment</th>
                                <th>Created</th>
                                <th>Remarks</th>
                            </tr>
                            <% orders.forEach((o)=> { %>
                                <tr class="<%= o.status === 'delivered' ? 'row-paid' : '' %>">

                                    <td>
                                        <%= o.tracking_no %>
                                    </td>
                                    <td>
                                        <%= o.customer %>
                                    </td>
                                    <td>
                                        <%= o.pickup_zone %>
                                    </td>
                                    <td>
                                        <%= o.dropoff_zone %>
                                    </td>
                                    <td
                                        class="<%= !['cancelled', 'delivered', 'returned'].includes(o.status) ? 'text-danger fw-semibold' : '' %>">
                                        <%= o.status %>
                                    </td>
                                    <td>
                                        <%= o.pay_method %>
                                    </td>
                                    <td>
                                        <span
                                            class="<%= o.pay_status === 'unpaid' && o.status !== 'cancelled' ? 'text-danger fw-semibold' : '' %>">
                                            <%= o.pay_status %>
                                        </span>
                                        <% if (o.pay_status==='unpaid' && o.pay_method !=='cod' && o.status
                                            !=='cancelled' ) { %>
                                            <form method="POST" action="/admin/orders/<%= o.id %>/paid"
                                                class="d-inline ms-3">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-success btn-sm">Mark paid</button>
                                            </form>
                                            <% } %>
                                    </td>
                                    <td>
                                        <%= new Date(o.created_at).toLocaleDateString() %>
                                    </td>
                                    <td class="small" style="white-space: normal; min-width: 200px;">
                                        <% if (o.allow_doorstep) { %>
                                            <div>Doorstep OK</div>
                                            <% } %>
                                                <% if (o.instructions) { %>
                                                    <div>
                                                        <%= o.instructions %>
                                                    </div>
                                                    <% } %>
                                                        <% if (o.collect_back) { %>
                                                            <div>Collect back<%= o.collect_back_note ? ': ' +
                                                                    o.collect_back_note : '' %>
                                                            </div>
                                                            <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </table>
                    </div>
</body>

</html>