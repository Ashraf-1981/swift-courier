<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .table th,
        .table td {
            padding: 14px 18px;
            white-space: nowrap;
        }
    </style>
</head>

<body class="p-4">
    <h1 class="h3">Orders</h1>
    <p><a href="/admin">← Admin home</a></p>
    <% if (msg) { %>
        <div class="alert alert-success">
            <%= msg %>
        </div>
        <% } %>
            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>
                    <form method="GET" action="/admin/orders" class="row g-2 mb-3">
                        <div class="col-md-2">
                            <select name="status" class="form-select">
                                <option value="">All statuses</option>
                                <% statuses.forEach((s)=> { %>
                                    <option value="<%= s %>" <%=filters.status===s ? 'selected' : '' %>><%= s %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="payment" class="form-select">
                                <option value="">All payments</option>
                                <option value="unpaid" <%=filters.payment==='unpaid' ? 'selected' : '' %>>unpaid
                                </option>
                                <option value="paid" <%=filters.payment==='paid' ? 'selected' : '' %>>paid</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="zoneId" class="form-select">
                                <option value="">All zones</option>
                                <% zones.forEach((z)=> { %>
                                    <option value="<%= z.id %>" <%=filters.zoneId===z.id ? 'selected' : '' %>><%= z.name
                                            %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="date" name="from" class="form-control" value="<%= filters.from || '' %>">
                        </div>
                        <div class="col-md-2">
                            <input type="date" name="to" class="form-control" value="<%= filters.to || '' %>">
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button class="btn btn-primary">Filter</button>
                            <a href="/admin/orders" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </form>

                    <p>
                        <%= orders.length %> order(s)
                    </p>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <tr class="table-secondary">
                            <th>Tracking no</th>
                            <th>Customer</th>
                            <th>Pickup → Drop-off</th>
                            <th>Status</th>
                            <th>Fee</th>
                            <th>Payment</th>
                            <th>Created</th>
                            </tr>
                            <% orders.forEach((o)=> { %>
                                <tr>
                                    <td>
                                        <%= o.tracking_no %>
                                    </td>
                                    <td>
                                        <%= o.customer %>
                                    </td>
                                    <td>
                                        <%= o.pickup_zone %> → <%= o.dropoff_zone %>
                                    </td>
                                    <td>
                                        <%= o.status %>
                                    </td>
                                    <td>$<%= o.total_fee %>
                                    </td>
                                    <td>
                                        <%= o.pay_method %> · <%= o.pay_status %>
                                                <% if (o.pay_status==='unpaid' && o.pay_method !=='cod' ) { %>
                                                    <form method="POST" action="/admin/orders/<%= o.id %>/paid"
                                                        class="d-inline ms-3">
                                                        <button class="btn btn-success btn-sm">Mark paid</button>
                                                    </form>
                                                    <% } %>
                                    </td>
                                    <td>
                                        <%= new Date(o.created_at).toLocaleDateString() %>
                                    </td>
                                </tr>
                                <% }) %>
                        </table>
                    </div>
</body>

</html>