<!doctype html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Users</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .table th, .table td { padding: 14px 18px; white-space: nowrap; }
  </style>
</head>

<body class="p-4">
  <h1 class="h3">Users</h1>
  <p><a href="/admin">← Admin home</a></p>

  <form method="GET" action="/admin/users" class="row g-2 mb-3">
    <div class="col-md-3">
      <select name="role" class="form-select">
        <option value="">All roles</option>
        <% roles.forEach((r) => { %>
          <option value="<%= r %>" <%= filters.role === r ? 'selected' : '' %>><%= r %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <input type="text" name="search" class="form-control" placeholder="Name or email"
        value="<%= filters.search || '' %>">
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button class="btn btn-primary">Filter</button>
      <a href="/admin/users" class="btn btn-outline-secondary">Clear</a>
    </div>
  </form>

  <p><%= users.length %> user(s)</p>

  <div class="table-responsive">
    <table class="table align-middle">
      <tr class="table-secondary">
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Role</th>
        <th>Zones</th>
        <th>Orders</th>
        <th>Joined</th>
      </tr>
      <% users.forEach((u) => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td><%= u.phone %></td>
          <td><%= u.role %><%= u.is_express ? ' (express)' : '' %></td>
          <td><%= u.role === 'courier' ? (u.zones || '-') : '' %></td>
          <td><%= u.role === 'customer' ? u.order_count : '' %></td>
          <td><%= new Date(u.created_at).toLocaleDateString() %></td>
        </tr>
      <% }) %>
    </table>
  </div>
</body>

</html>