<!doctype html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Warehouse</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="p-4">
  <h1 class="h3">Parcels at warehouse</h1>
  <p><a href="/admin">← Admin home</a></p>

  <% if (msg) { %>
    <div class="alert alert-success">
      <%= msg %>
    </div>
    <% } %>
      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
        <% } %>

          <% if (parcels.length===0) { %>
            <p>No parcels at the warehouse.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table">
                  <tr>
                    <th>Tracking no</th>
                    <th>Drop-off zone</th>
                    <th>Vehicle</th>
                    <th>Hand out</th>
                  </tr>
                  <% parcels.forEach((p)=> { %>
                    <tr>
                      <td>
                        <%= p.tracking_no %>
                      </td>
                      <td>
                        <%= p.dropoff_zone %>
                      </td>
                      <td>
                        <%= p.vehicle %>
                      </td>
                      <td>
                        <form method="POST" action="/admin/warehouse/<%= p.id %>/assign" class="d-flex gap-2">
                          <select name="courierId" class="form-select form-select-sm" required>
                            <option value="">Pick courier</option>
                            <% p.couriers.forEach((c)=> { %>
                              <option value="<%= c.id %>">
                                <%= c.name %>
                              </option>
                              <% }) %>
                          </select>
                          <button class="btn btn-primary btn-sm">Hand out</button>
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                </table>
              </div>
              <% } %>
</body>

</html>